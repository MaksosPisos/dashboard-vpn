# Production env for docker-compose.prod.yml
# Copy to .env on the server: cp .env.production.example .env

# --- Server ---
DOMAIN=vm86654.it-garage.network
# Server IP (for DNS A-record): 144.31.98.57

# --- PostgreSQL (docker internal) ---
POSTGRES_PASSWORD=change-me-strong-password

# --- API ---
JWT_SECRET=change-me-long-random-string
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_ADMIN_IDS=
BOT_API_KEY=change-me-bot-api-key

# --- Cron (expiry reminders) ---
CRON_EXPIRY_REMINDERS_ENABLED=true
CRON_EXPIRY_REMINDERS_SCHEDULE=0 10 * * *
CRON_TIMEZONE=Europe/Moscow

# --- FreeKassa ---
FREEKASSA_MERCHANT_ID=
FREEKASSA_SECRET_WORD_1=
FREEKASSA_SECRET_WORD_2=
PUBLIC_API_URL=https://vm86654.it-garage.network/api

# Built into docker-compose (do not change unless you know why):
# DATABASE_URL=postgresql://vpn_admin:${POSTGRES_PASSWORD}@postgres:5432/dashboard_vpn?schema=public
# API_INTERNAL_URL=http://api:3001
# VITE_API_URL=/api (set at web build time in Dockerfile.nginx)
