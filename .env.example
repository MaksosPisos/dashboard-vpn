# Database
DATABASE_URL="postgresql://vpn_admin:vpn_admin@localhost:5432/dashboard_vpn?schema=public"

# API
API_PORT=3001
JWT_SECRET=change-me-in-production
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# Web (Vite) — /api проксируется через Vite в dev
VITE_API_URL=/api

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_SUPPORT_USERNAME=
TELEGRAM_ADMIN_IDS=
BOT_API_KEY=dev-bot-api-key
API_INTERNAL_URL=http://localhost:3001
# Cron: напоминания об истекающих подписках (Telegram)
CRON_EXPIRY_REMINDERS_ENABLED=true
CRON_EXPIRY_REMINDERS_SCHEDULE=0 10 * * *
CRON_TIMEZONE=Europe/Moscow

# FreeKassa (https://merchant.freekassa.net/settings)
FREEKASSA_MERCHANT_ID=
FREEKASSA_SECRET_WORD_1=
FREEKASSA_SECRET_WORD_2=
# Публичный URL API для webhook (без /api в конце): https://your-domain.com/api
PUBLIC_API_URL=
