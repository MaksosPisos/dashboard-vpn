# Database
DATABASE_URL="postgresql://vpn_admin:vpn_admin@localhost:5432/dashboard_vpn?schema=public"

# API
API_PORT=3001
JWT_SECRET=change-me-in-production
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# Web (Vite) — /api проксируется через Vite в dev
VITE_API_URL=/api

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_ADMIN_IDS=
BOT_API_KEY=dev-bot-api-key
API_INTERNAL_URL=http://localhost:3001

# API использует тот же TELEGRAM_BOT_TOKEN для отправки уведомлений клиентам

# Cron: напоминания об истекающих подписках (Telegram)
CRON_EXPIRY_REMINDERS_ENABLED=true
CRON_EXPIRY_REMINDERS_SCHEDULE=0 10 * * *
CRON_TIMEZONE=Europe/Moscow
